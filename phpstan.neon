includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database
        - routes
    reportUnmatchedIgnoredErrors: false
    # No ignoreErrors. BelongsToTenant and TenantAware both have real app/
    # consumers now — the trait.unused entry for TenantAware was waiting for
    # exactly this: app/Jobs/Projects/NotifyProjectStatusChange uses it.
