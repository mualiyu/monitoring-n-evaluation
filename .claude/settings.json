{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(composer:*)",
      "Bash(php artisan:*)",
      "Bash(php -v)",
      "Bash(npm install)",
      "Bash(npm run:*)",
      "Bash(npx:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress)",
      "Bash(cp app/Providers/TenancyServiceProvider.php *)",
      "Bash(xargs -n1 basename)",
      "Bash(sort -t'>' -k2)",
      "Bash(uniq -f1)",
      "Bash(curl -s -o /dev/null -w 'HTTP %{http_code} from %{url_effective}\\\\n' --max-time 4 __TRACKED_VAR__/@vite/client)",
      "Bash(grep -oE \"^[^:]+:[0-9]+|url\\\\\\('[^']*'|route\\\\\\('[^']*'|href=\\\\\"#\\\\\"|href=\\\\\"\\\\{\\\\{ *\\\\\\\\\\\\$[a-zA-Z_>-]*\")",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Bash(git check-ignore *)",
      "Bash(git stash *)",
      "Bash(git rm *)",
      "Bash(grep -oE '\\\\$paginator->[a-zA-Z]+' resources/views/components/ui/pagination.blade.php)",
      "Bash(php -r 'var_dump\\(is_numeric\\(\"5.\"\\), \\(bool\\) preg_match\\(\"/^\\([+-]?\\)\\(\\\\d+\\)\\(?:\\\\.\\(\\\\d+\\)\\)?$/\", \"5.\"\\), is_numeric\\(\"1e5\"\\), \\(bool\\) preg_match\\(\"/^\\([+-]?\\)\\(\\\\d+\\)\\(?:\\\\.\\(\\\\d+\\)\\)?$/\", \"1e5\"\\)\\);')"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(storage/app/private/**)",
      "Bash(rm -rf:*)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "teammateMode": "auto"
}
